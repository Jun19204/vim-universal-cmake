{
  "inlayHint.enable": true,

  "clangd.inlayHints.enable": true,
  "clangd.inlayHints.designators": true,
  "clangd.inlayHints.parameterNames": true,
  "clangd.inlayHints.deducedTypes": true,

  "clangd.arguments": [
    "--background-index",
    "--clang-tidy",
    "--header-insertion=iwyu",
    "--completion-style=detailed"
  ],

  "semanticTokens.enable": true,

  "suggest.noselect": true,
  "suggest.enablePreview": true,

  "suggest.floatConfig": {
    "border": true
  },

  "diagnostic.floatConfig": {
    "border": true
  },

  "hover.floatConfig": {
    "border": true
  }
}

